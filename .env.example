# Пример окружения. Реальные ЗНАЧЕНИЯ секретов сюда не пишутся никогда —
# они живут только в Azure Key Vault. Скопируйте в .env (он в .gitignore)
# и подставьте своё имя хранилища и свои имена секретов.

# Имя Azure Key Vault, откуда читать секреты
KEYVAULT_NAME=your-keyvault-name

# Имена секретов в хранилище (НЕ значения)
X_BEARER_TOKEN_SECRET=your-x-bearer-token-secret-name
EXA_API_KEY_SECRET=your-exa-api-key-secret-name
GITHUB_TOKEN_SECRET=your-github-token-secret-name
ANTHROPIC_API_KEY_SECRET=your-anthropic-api-key-secret-name
PERPLEXITY_API_KEY_SECRET=your-perplexity-api-key-secret-name
# Куда уходит ДАЙДЖЕСТ (адресат читателя: канал или личный чат)
TELEGRAM_BOT_TOKEN_SECRET=your-telegram-bot-token-secret-name
TELEGRAM_CHAT_ID_SECRET=your-telegram-chat-id-secret-name

# Куда уходят АВАРИИ (адресат владельца). Необязательны: без них аварии
# идут туда же, куда дайджест, — прежнее поведение.
# Задавать обязательно, если дайджест уезжает в ПУБЛИЧНЫЙ канал: иначе
# «⚠️ Дайджест не отправлен» увидят подписчики.
# Отдельный бот нужен, когда бот канала не вправе писать владельцу в личку:
# Telegram запрещает боту писать первым, пока человек не нажал Start.
TELEGRAM_ALERT_BOT_TOKEN_SECRET=your-alert-bot-token-secret-name
TELEGRAM_ALERT_CHAT_ID_SECRET=your-owner-chat-id-secret-name

# Необязательно: без него сервис работает, просто без трекинга ошибок
SENTRY_DSN_SECRET=your-sentry-dsn-secret-name

# Альтернатива для локального прогона без Key Vault: задать значение напрямую
# одноимённой переменной (X_BEARER_TOKEN=..., TELEGRAM_BOT_TOKEN=... и т.д.).
# Так делать только локально и не коммитить.
